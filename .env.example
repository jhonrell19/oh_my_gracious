# OH MY GRACIOUS - local/deployment environment template
APP_ENV=local
APP_URL=http://localhost/oh_my_gracious
APP_TIMEZONE=Asia/Manila

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oh_my_gracious
DB_USER=root
DB_PASSWORD=

# Google Identity Services - Web application OAuth Client ID
# Example: 123456789-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Used by the current email-verification fallback. Configure a real mail transport
# before public deployment if you keep password/email registration enabled.
MAIL_FROM=no-reply@ohmygracious.local
MAIL_FROM_NAME=Oh My Gracious

# Enable only after registering the webhook. Test keys first.
PAYMONGO_ENABLED=false
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=gcash,paymaya,qrph,card

SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
